  "fieldname": "custom_website_settings",
  "fieldtype": "Section Break",
  "label": "Website Settings",
  "insert_after": "taxes"
 },
 {
  "doctype": "Custom Field",
  "name": "Item Group-show_in_website",
  "dt": "Item Group",
  "fieldname": "show_in_website",
