  "fieldname": "supplier_items",
  "fieldtype": "Table",
  "label": "Tedarikçiler",
  "options": "Website Item Supplier",
  "insert_after": "supplier_section"
 },
 {
  "doctype": "Custom Field",
  "name": "Website Item-primary_supplier",
  "dt": "Website Item",
  "fieldname": "primary_supplier",
  "fieldtype": "Link",
  "label": "Ana Tedarikçi",
  "options": "Supplier",
