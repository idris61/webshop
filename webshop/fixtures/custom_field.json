 },
 {
  "doctype": "Custom Field",
  "name": "Homepage-products_section_break",
  "dt": "Homepage",
  "fieldname": "products_section_break",
  "fieldtype": "Section Break",
  "label": "Products",
  "insert_after": "hero_section"
 },
 {
  "doctype": "Custom Field",
  "name": "Homepage-products_url",
  "dt": "Homepage",
  "fieldname": "products_url",
  "fieldtype": "Data",
  "label": "URL for All Products",
  "insert_after": "products_section_break"
 },
 {
  "doctype": "Custom Field",
  "name": "Homepage-products",
  "dt": "Homepage",
  "fieldname": "products",
